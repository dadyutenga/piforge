[Unit]
Description=PiForge Raspberry Pi workspace
After=network-online.target
Wants=network-online.target
After=piforge-wifi-helper.service
Wants=piforge-wifi-helper.service
After=piforge-bluetooth-helper.service
Wants=piforge-bluetooth-helper.service

[Service]
Type=simple
User=dadi
Group=dadi
SupplementaryGroups=systemd-journal
WorkingDirectory=/home/dadi/PiForge
ExecStart=/home/dadi/piforge-app/piforge
Environment=PIFORGE_ADDRESS=0.0.0.0:8787
Environment=PIFORGE_STATIC_DIR=/home/dadi/piforge-app/static
Environment=PIFORGE_TLS_CERT=/home/dadi/.local/share/piforge/tls/server.crt
Environment=PIFORGE_TLS_KEY=/home/dadi/.local/share/piforge/tls/server.key
Environment=PIFORGE_WIFI_HELPER_SOCKET=/run/piforge-helper/control.sock
Environment=PIFORGE_BLUETOOTH_HELPER_SOCKET=/run/piforge-bluetooth/control.sock
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/dadi/PiForge /home/dadi/.local/share/piforge
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
LimitNOFILE=1024
TasksMax=80
MemoryMax=350M

[Install]
WantedBy=multi-user.target
